{
  "multipart": [
    {
      "when": {
        "straight": "false"
      },
      "apply": {
        "model": "newearth:transfer_pipe/center"
      }
    },
    {
      "when": {
        "straight": "false",
        "north": "pipe"
      },
      "apply": {
        "model": "newearth:transfer_pipe/connection"
      }
    },
    {
      "when": {
        "north": "device"
      },
      "apply": {
        "model": "newearth:transfer_pipe/import_bus"
      }
    },
    {
      "when": {
        "straight": "false",
        "east": "pipe"
      },
      "apply": {
        "model": "newearth:transfer_pipe/connection",
        "y": 90
      }
    },
    {
      "when": {
        "east": "device"
      },
      "apply": {
        "model": "newearth:transfer_pipe/import_bus",
        "y": 90
      }
    },
    {
      "when": {
        "straight": "false",
        "south": "pipe"
      },
      "apply": {
        "model": "newearth:transfer_pipe/connection",
        "y": 180
      }
    },
    {
      "when": {
        "south": "device"
      },
      "apply": {
        "model": "newearth:transfer_pipe/import_bus",
        "y": 180
      }
    },
    {
      "when": {
        "straight": "false",
        "west": "pipe"
      },
      "apply": {
        "model": "newearth:transfer_pipe/connection",
        "y": 270
      }
    },
    {
      "when": {
        "west": "device"
      },
      "apply": {
        "model": "newearth:transfer_pipe/import_bus",
        "y": 270
      }
    },
    {
      "when": {
        "straight": "false",
        "down": "pipe"
      },
      "apply": {
        "model": "newearth:transfer_pipe/connection",
        "x": 90
      }
    },
    {
      "when": {
        "down": "device"
      },
      "apply": {
        "model": "newearth:transfer_pipe/import_bus",
        "x": 90
      }
    },
    {
      "when": {
        "straight": "false",
        "up": "pipe"
      },
      "apply": {
        "model": "newearth:transfer_pipe/connection",
        "x": 270
      }
    },
    {
      "when": {
        "up": "device"
      },
      "apply": {
        "model": "newearth:transfer_pipe/import_bus",
        "x": 270
      }
    },
    {
      "when": {
        "straight": "true",
        "north": "pipe"
      },
      "apply": {
        "model": "newearth:transfer_pipe/straight"
      }
    },
    {
      "when": {
        "straight": "true",
        "east": "pipe"
      },
      "apply": {
        "model": "newearth:transfer_pipe/straight",
        "y": 90
      }
    },
    {
      "when": {
        "straight": "true",
        "down": "pipe"
      },
      "apply": {
        "model": "newearth:transfer_pipe/straight",
        "x": 90
      }
    }
  ]
}
