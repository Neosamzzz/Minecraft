{
  "title": "似曾相识",
  "icon": "minecraft:grass",
  "description": [
    "河岸开着花，森林延伸到雪山脚下。走过这么多地方，眼前的一切忽然熟悉起来。只是山更高，原野更远，抬头也不再是出发时的星空。"
  ],
  "always_invisible": false,
  "group": 0,
  "default_quest_shape": "circle",
